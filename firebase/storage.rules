rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images: public read, uploaded by you with the Admin SDK / console.
    match /products/{file=**} { allow read: if true; allow write: if false; }
    // Avatars: only the owner can write; any signed-in user can read.
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid + '.jpg' == fileName
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
