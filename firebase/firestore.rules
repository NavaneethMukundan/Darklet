rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalogue (guests can browse): anyone can read, nobody can write from the app.
    match /products/{id}   { allow read: if true; allow write: if false; }
    match /categories/{id} { allow read: if true; allow write: if false; }

    // Reviews: readable by signed-in users; users may only create reviews as themselves.
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // Everything below belongs to one user.
    match /users/{uid}/{document=**} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /carts/{uid}     { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /wishlists/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }

    // Promo codes: readable (to validate in the app); only the server writes them.
    match /coupons/{code} { allow read: if request.auth != null; allow write: if false; }

    // Orders are created / cancelled ONLY by Cloud Functions (Admin SDK bypasses rules);
    // users can read their own.
    match /orders/{id} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
